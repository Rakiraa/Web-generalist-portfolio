// Cloudflare Workers with static assets: serves the Astro build from ./dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-generalist-portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // the portfolio's own domain; Cloudflare creates the DNS records and certificates for these
  "routes": [
    { "pattern": "rafael-akira.com", "custom_domain": true },
    { "pattern": "www.rafael-akira.com", "custom_domain": true }
  ]
}
