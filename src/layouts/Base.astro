---
import '@fontsource/ibm-plex-sans/300.css';
import '@fontsource/ibm-plex-sans/300-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/300.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import ContentSwitcher from '../components/ContentSwitcher.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  current: 'work' | 'about';
}

const { title = site.title, description = site.description, current } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="page">
      <Header />
      <Hero />
      <Intro />
      <ContentSwitcher current={current} />
      <main id="content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 8px;
    top: -48px;
    z-index: 10;
    padding: 8px 16px;
    background: var(--cds-background-inverse);
    color: var(--cds-text-inverse);
  }
  .skip:focus {
    top: 8px;
  }
  main:focus {
    outline: none;
  }
</style>
