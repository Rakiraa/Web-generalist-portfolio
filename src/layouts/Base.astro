---
import '@fontsource/ibm-plex-sans/300.css';
import '@fontsource/ibm-plex-sans/300-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/300.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.scss';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import ContentSwitcher from '../components/ContentSwitcher.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  current: 'work' | 'about';
}

const { title = site.title, description = site.description, current } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#161616" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // White by day, Gray 100 by night, on São Paulo time, before the first paint. Same rule as the navbar
      // clock (src/scripts/theme.ts): 5:00–17:59 is day. Re-applied after Work ⇄ About swaps, which reset <html>.
      (function () {
        var d = document.documentElement;
        function apply() {
          d.classList.add('js');
          var h = +new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Sao_Paulo', hour: '2-digit', hour12: false }).format(new Date()) % 24;
          var t = h >= 5 && h < 18 ? 'white' : 'g100';
          if (d.dataset.theme !== t) d.dataset.theme = t;
          d.style.colorScheme = t === 'white' ? 'light' : 'dark';
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'white' ? '#ffffff' : '#161616');
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="page">
      <!-- The top stays mounted across Work ⇄ About: only <main> is swapped -->
      <div transition:persist="top">
        <Header />
        <Hero />
        <Intro />
        <ContentSwitcher current={current} />
      </div>
      <main id="content" tabindex="-1">
        <slot />
      </main>
      <div transition:persist="footer">
        <Footer />
      </div>
    </div>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 8px;
    top: -48px;
    z-index: 10;
    padding: 8px 16px;
    background: var(--cds-background-inverse);
    color: var(--cds-text-inverse);
  }
  .skip:focus {
    top: 8px;
  }
  main:focus {
    outline: none;
  }
</style>
